; =====================================================================
;  JOURNAL_solve_csv -- rodada new_sim_turb.
;  GERADO por make_solve_csv_journal.py. Nao edite a mao.
;
;  Resolve 1000 passos de 0.1 s; t_*.csv a cada 1 passo(s), direto da
;  memoria do solver (nunca relendo .dat.h5).
;
;  UNICA MUDANCA NA FISICA em relacao a rodada anterior (job 5518):
;      Maximum Turb. Viscosity Ratio  1e5 (default)  ->  1e7
;  Todo o resto que e novo aqui e exportacao.
; =====================================================================
/file/set-tui-version "25.2"
/file/confirm-overwrite? no
; Transcript: TUDO que o Fluent imprime -- inclusive residuos e o numero
; de iteracoes do SIMPLE por passo -- vai junto dos CSV (handoff 3.5).
; O monitor_esteira.py le a contagem de iteracoes daqui durante o job.
/file/start-transcript "results/meta/transcript.txt"
; As duas linhas do webserver vem do journal original (diff minimo).
(putenv "FLUENT_WEBSERVER_TOKEN" "your_secure_token_here")
/serve/start-web-server "Fluent WebUI" 5000 0 "" ""
; ---------------------------------------------------------------------
; Malha: caminho ABSOLUTO.
; ---------------------------------------------------------------------
/file/read-case "/home/ybonilha/simulations_CFD/new_sim_turb/geometria_malha/malha_simples_boi.msh.h5"
; ---------------------------------------------------------------------
; Fisica -- IDENTICA a rodada anterior, linha por linha.
; ---------------------------------------------------------------------
/define/models/unsteady-2nd-order? yes
/define/models/viscous/kw-sst? yes
; BCs por NOME de zona. Nome errado = prompt pendente = journal
; desalinhado em silencio. Confira com o probe antes de rodar.
/define/boundary-conditions/set/velocity-inlet inlet () vmag no 17 quit
/define/boundary-conditions/set/pressure-outlet outlet () prevent-reverse-flow? yes quit
; Parede movel: um comando por zona (forma ja verificada).
/define/boundary-conditions/set/wall lateral_min () motion-bc yes motion-bc-moving relative? no rotating? no components? no vmag no 17 ni 0 nj 1 quit
/define/boundary-conditions/set/wall lateral_max () motion-bc yes motion-bc-moving relative? no rotating? no components? no vmag no 17 ni 0 nj 1 quit
/define/boundary-conditions/set/wall top () motion-bc yes motion-bc-moving relative? no rotating? no components? no vmag no 17 ni 0 nj 1 quit
; ground, cylinder_wall, cylinder_top: parede fixa no-slip = default, sem comando.
; ---------------------------------------------------------------------
; NUMERICA -- SIMPLE (20) e momento Third-Order MUSCL (6). k e omega
; ficam no default (2nd Order Upwind, conforme o summary da rodada
; anterior), assim como wall-omega-treatment = correlation. Nao se
; acrescenta comando para eles: mudar uma variavel so.
; ---------------------------------------------------------------------
(ti-menu-load-string "/solve/set/p-v-coupling 20")

(ti-menu-load-string "/solve/set/discretization-scheme/mom 6")

; ---------------------------------------------------------------------
; A MUDANCA DESTA RODADA: teto de mu_t/mu.
;
; /solve/set/limits pergunta os limites EM SEQUENCIA. Cada "," abaixo
; aceita o default de um prompt (Text Command List, 2.2). Sao 4 antes
; do teto (p_abs min, p_abs max, k min, omega min) -- ordem lida em
; sessao interativa do 25.2. O teto e o 5o e ULTIMO prompt.
; ---------------------------------------------------------------------
/solve/set/limits
,
,
,
,
1e7



; ECO DE CONFERENCIA: o mesmo comando, so com linhas em branco. Nao muda
; nada; imprime cada limite com o valor ATUAL entre colchetes. No log tem
; que aparecer:  Maximum allowable turbulent/laminar viscosity ratio [10000000]
; e TODOS os outros com o default de antes. O solve_csv.slurm confere.
/solve/set/limits












; ---------------------------------------------------------------------
; Autosave a cada 200 passos, SO como ponto de restart. Reler case+data
; noutra sessao devolveu campo PERMUTADO no job 5479. Se precisar,
; valide com check_field.py antes de confiar. O dado bom e o CSV.
; ---------------------------------------------------------------------
/file/auto-save/root-name "results/dat_cas/restart"
/file/auto-save/data-frequency 200
/file/auto-save/case-frequency if-mesh-is-modified
/solve/set/time-step 0.1
/solve/initialize/hyb-initialization
; ---------------------------------------------------------------------
; REGISTRO DO QUE O SOLVER FEZ (handoff 3.5): summary no log, o mesmo
; summary em arquivo, e o .cas (so case, sem dados -- nada e relido).
; ---------------------------------------------------------------------
(ti-menu-load-string "/report/summary")

; "write to files? [no]" -> yes ; "report summary filename" -> caminho
(ti-menu-load-string "/report/summary yes results/meta/report_summary.txt")

/file/write-case "results/meta/setup.cas.h5"
(ti-menu-load-string "/parallel/timer/reset")

